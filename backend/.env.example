# =============================================================
# AI Banking Advisor — Environment Configuration
# =============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================

# --- Database ---
DATABASE_URL=postgresql+asyncpg://postgres:your_password_here@localhost:5432/banking_advisor

# --- JWT Authentication ---
JWT_SECRET_KEY=change-this-to-a-random-secret-string-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Groq LLM ---
# Get your free API key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# --- App Settings ---
APP_NAME=AI Banking Advisor
APP_ENV=development
CORS_ORIGINS=http://localhost:3000
